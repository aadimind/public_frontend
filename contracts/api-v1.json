  "authTransport":{"login":{"responseSessionMaterial":"cookies-only","mfaRequired":true},"refresh":{"requestBody":false,"refreshTokenSource":"mm_refresh cookie","responseRefreshMaterial":"cookie-only"},"logout":{"sessionMaterial":"cookie-only"},"mfaCompletion":{"requiresVerifiedProof":true,"sessionMaterial":"cookies-only"}},
  "databaseCompatibility":{"migrationPolicy":"Do not alter database schema for client-contract-only changes","mfaReplayMigration":"0009_mfa_totp_replay_and_completion.sql","contractVersionIsNotStoredInBusinessTables":true}
