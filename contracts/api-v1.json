  "title": "Micromath API v1 Canonical Resource Contract",
  "contractVersion": "1.0.0",
  "sourceOfTruth": "aadimind/backend",
  "security": {"adminSession":"HttpOnly Secure SameSite=Strict mm_session cookie","refreshSession":"HttpOnly Secure SameSite=Strict mm_refresh cookie","refreshTransport":"cookie-only","rawCredentialsInJson":false},
  "resources": {
    "content":{"create":["title","slug","contentType","excerpt","content","contentFormat","language","status","visibility","featured","pinned","allowComments","allowSharing","readingTime","wordCount","authorId","coverMediaId","thumbnailMediaId","publishedAt","scheduledAt","deletedAt","metadataJson"],"update":["title","slug","contentType","excerpt","content","contentFormat","language","status","visibility","featured","pinned","allowComments","allowSharing","readingTime","wordCount","authorId","coverMediaId","thumbnailMediaId","publishedAt","scheduledAt","deletedAt","metadataJson"],"list":["status","contentType","cursor","limit"]},
    "page":{"create":["title","slug","pageType","status","content","contentFormat","customCss","customJs","headerCode","footerCode","publishedAt","coverMediaId"],"update":["title","slug","pageType","status","content","contentFormat","customCss","customJs","headerCode","footerCode","publishedAt","coverMediaId"],"list":["status","pageType","cursor","limit"]},
    "researchPaper":{"create":["contentId","title","abstract","journal","conference","publisher","publicationDate","doi","arxivId","pmid","paperUrl","pdfUrl","field","paperType","methodology","license","citation","status"],"update":["contentId","title","abstract","journal","conference","publisher","publicationDate","doi","arxivId","pmid","paperUrl","pdfUrl","field","paperType","methodology","license","citation","status"],"list":["status","cursor","limit"],"counts":["publicationYear"]},
    "paperAuthor":{"create":["researchPaperId","authorName","affiliation","orcid","authorOrder"],"update":["researchPaperId","authorName","affiliation","orcid","authorOrder"],"list":["researchPaperId","cursor","limit"]},
    "researchSection":{"create":["researchPaperId","parentId","title","slug","sectionOrder","depth","content","contentFormat"],"update":["researchPaperId","parentId","title","slug","sectionOrder","depth","content","contentFormat"],"list":["researchPaperId","cursor","limit"]},
    "media":{"create":["filename","originalName","mimeType","mediaType","storageUrl","thumbnailUrl","altText","caption","width","height","fileSize","duration","metadata","status"],"update":["filename","originalName","mimeType","mediaType","storageUrl","thumbnailUrl","altText","caption","width","height","fileSize","duration","metadata","status"],"list":["status","mediaType","cursor","limit"]},
    "visual":{"create":["title","visualType","mediaId","caption","altText","description","credit","sourceUrl","metadata"],"update":["title","visualType","mediaId","caption","altText","description","credit","sourceUrl","metadata"],"list":["visualType","cursor","limit"]},
    "ad":{"create":["name","placement","adType","content","mediaId","targetType","targetId","priority","status","startAt","endAt","metadata"],"update":["name","placement","adType","content","mediaId","targetId","priority","status","startAt","endAt","metadata"],"list":["placement","status","cursor","limit"]},
