{
  "name": "micromath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {"node": ">=24"},
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/sync-sitemap.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --no-warnings ./scripts/smoke.mts",
    "contract:sync": "node ./scripts/sync-api-contract.mjs",
    "contract:verify": "node ./scripts/verify-api-contract.mjs",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.25.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wrangler": "^4.80.0"
  }
}
